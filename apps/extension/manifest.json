{
  "manifest_version": 3,
  "name": "Neptune — Assistant navigateur",
  "short_name": "Neptune",
  "version": "1.0.0",
  "version_name": "1.0 Production",
  "description": "Assistant navigateur conversationnel, vocal et contrôlé, avec intelligence locale ou cloud.",
  "minimum_chrome_version": "138",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ouvrir Neptune"
  },
  "commands": {
    "activate-neptune": {
      "suggested_key": {
        "default": "Ctrl+Shift+N",
        "mac": "Command+Shift+N"
      },
      "description": "Ouvrir Neptune"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https: http://127.0.0.1:* http://localhost:*"
  }
}
