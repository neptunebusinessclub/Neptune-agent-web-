{
  "manifest_version": 3,
  "name": "Neptune Agent Web",
  "short_name": "Neptune",
  "version": "0.4.0",
  "description": "Bras navigateur de Neptune Runtime avec onglet de travail dédié et validation humaine.",
  "minimum_chrome_version": "114",
  "key": "",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Ouvrir Neptune Agent"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
