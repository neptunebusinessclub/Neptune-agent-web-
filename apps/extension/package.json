{
  "name": "@neptune/extension",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/prepare-embedded-voices.mjs && node ../../scripts/generate-extension-icons.mjs && node esbuild.mjs --watch",
    "build": "node ../../scripts/prepare-embedded-voices.mjs && node ../../scripts/generate-extension-icons.mjs && node esbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@mintplex-labs/piper-tts-web": "1.0.4",
    "@mlc-ai/web-llm": "^0.2.84",
    "@neptune/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "esbuild": "^0.25.5",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
