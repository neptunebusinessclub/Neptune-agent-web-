{
  "name": "@neptune/worker-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests",
    "db:migrate:local": "wrangler d1 migrations apply neptune-agent-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply neptune-agent-db --remote"
  },
  "dependencies": {
    "@neptune/protocol": "workspace:*",
    "hono": "^4.12.31",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260716.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  }
}
